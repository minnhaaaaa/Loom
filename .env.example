# Copy to .env at the repository root. Do not commit secrets.
# No connection configured = read-only sample preview, never an alternate data store.
APP_ORIGIN=http://localhost:3000
LOOM_AUTH_MODE=local-demo
# Generate with: openssl rand -hex 32
LOOM_SESSION_SECRET=
# Optional; demo UI is restricted to loopback unless deliberately enabled.
LOOM_ALLOW_DEMO_PRODUCTION=false
EXASOL_HOST=
EXASOL_PORT=8563
EXASOL_SCHEMA=LOOM
EXASOL_USER=
EXASOL_PASSWORD=
# Trusted PEM CA; hostname validation remains enabled.
EXASOL_CA_FILE=

# Required for model runs. Choose an OpenRouter model with structured-output support.
# There is no default model, heuristic engine, or simulated production response.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_OUTPUT_TOKENS=4096
OPENROUTER_TIMEOUT_MS=60000
# Explicit opt-in for paid model calls in the connected browser suite.
LOOM_TEST_LIVE_MODEL=false
