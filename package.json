{
  "name": "loom",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @loom/web dev",
    "build": "pnpm --filter @loom/web build",
    "start": "pnpm --filter @loom/web start",
    "typecheck": "tsc --noEmit && pnpm --filter @loom/web typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:check": "tsx --env-file-if-exists=.env scripts/db-check.ts",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db-migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db-seed.ts",
    "test:db": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.database.config.ts",
    "format": "prettier --write apps packages scripts tests *.ts *.mjs *.json *.yaml",
    "format:check": "prettier --check apps packages scripts tests *.ts *.mjs *.json *.yaml",
    "db:setup": "bash scripts/setup-exasol.sh",
    "test:e2e:connected": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test --config=playwright.connected.config.ts",
    "db:status": ".local/bin/exasol status --deployment-dir .local/exasol",
    "db:start": ".local/bin/exasol start --deployment-dir .local/exasol",
    "db:stop": ".local/bin/exasol stop --deployment-dir .local/exasol",
    "test:restart": "tsx --env-file-if-exists=.env scripts/check-triage-restart.ts",
    "model:check": "node --conditions=react-server --env-file-if-exists=.env --import tsx scripts/check-model.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.9",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vitest": "5.0.5"
  },
  "type": "module"
}
