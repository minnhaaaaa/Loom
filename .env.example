# Copy to .env at the repository root. Do not commit secrets.
# No database configured = unavailable workspace. Never show substitute records.
APP_ORIGIN=http://127.0.0.1:3000
# Canonical host/origin for browser and MCP requests; use HTTPS for remote agents.
# Use workspace for real local accounts. local-demo is only for isolated synthetic tests.
LOOM_AUTH_MODE=workspace
# Enable company self-registration; invitations work with this off.
LOOM_ALLOW_WORKSPACE_SIGNUP=false
# Authorized queue/detail polling, 1000-30000 ms.
LOOM_POLL_INTERVAL_MS=3000
# Generate with: openssl rand -hex 32
LOOM_SESSION_SECRET=
# Test builds only; also requires local-demo mode and a loopback origin.
LOOM_ALLOW_DEMO_PRODUCTION=false
# Development fixture seeding requires an explicit opt-in and loopback origin.
LOOM_ALLOW_SEED_FIXTURES=false
EXASOL_HOST=
EXASOL_PORT=8563
EXASOL_SCHEMA=LOOM
EXASOL_USER=
EXASOL_PASSWORD=
# Trusted PEM CA; hostname validation remains enabled.
EXASOL_CA_FILE=

# Optional global API provider. Company AI or a personal ChatGPT connection can be used instead.
# Choose an OpenRouter model with structured-output support when enabling this provider.
# There is no default model, heuristic engine, or simulated production response.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Optional separate designer model; blank uses OPENROUTER_MODEL.
OPENROUTER_TOOL_MODEL=
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_TIMEOUT_MS=90000
# Explicit opt-in for live provider calls in the connected browser suite.
LOOM_TEST_LIVE_MODEL=false
# Explicit opt-in for the live describe -> review -> publish browser journey.
LOOM_TEST_LIVE_TOOL_GENERATION=false

# Free-only routing is the default; blocks paid model IDs and applies a $0 price cap.
OPENROUTER_FREE_ONLY=true

# Optional; leave unset for the router so each selected model uses supported reasoning settings.
# OPENROUTER_REASONING_ENABLED=false

# Encrypt company-owned AI credentials at rest. Set 64 hex characters (openssl rand -hex 32).
# Keep this key stable and backed up separately from the database. Never commit it.
LOOM_PROVIDER_ENCRYPTION_KEY=

# Local open-source ChatGPT OAuth; no partner client ID or client secret is used.
# Requires APP_ORIGIN=http://127.0.0.1:<port>, workspace login and the encryption key above.
# The server must remain bound to loopback. Remote/localhost OAuth origins are rejected.
# Callback: http://127.0.0.1:<port>/api/oauth/openai/callback
LOOM_OPENAI_LOCAL_ENABLED=false
# Stable per-computer ID: urn:uuid:<UUIDv4>. Generate once; keep it across restarts.
# Optional: if blank, Loom saves a generated ID in .local/openai-host-id under
# the server working directory, with owner-only permissions. Do not copy it to another host.
LOOM_OPENAI_HOST_ID=
# Sign-in uses the official system browser consent flow and stores issued client IDs
# and rotating tokens encrypted in Exasol, separately per Loom owner and company.
# Each owner's ChatGPT plan is only used for that owner's eligible requests.
# Docs: https://developers.openai.com/siwc/token-sharing-open-source/sign-in
# Optional initial model ID; otherwise choose a model after connecting ChatGPT.
LOOM_CHATGPT_MODEL=

# Automatic read-only source imports run inside the local application server.
# Uses LOOM_PROVIDER_ENCRYPTION_KEY above for Slack and Microsoft credentials.
LOOM_SOURCE_SYNC=true
# Microsoft Entra public-client app in your own organization; enable device flow.
# See CONNECTED_SOURCES.md for delegated read permissions and admin consent.
LOOM_MICROSOFT_CLIENT_ID=
LOOM_MICROSOFT_TENANT_ID=
